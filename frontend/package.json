{
  "name": "duongtest-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Giao diện quản lý tuyển dụng prototype với JavaScript và CSS thuần, chạy trong Frappe",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && yarn copy-html-entry",
    "copy-html-entry": "cp ../duongtest/public/frontend/index.html ../duongtest/www/duongtest.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
